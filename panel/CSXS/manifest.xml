<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0"
    ExtensionBundleId="com.bunnysframelab.audioseparator"
    ExtensionBundleVersion="0.2.0"
    ExtensionBundleName="Bunnys Audio Separator"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.bunnysframelab.audioseparator.panel" Version="0.2.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <!-- Premiere Pro 2019 (13.0) and newer -->
      <Host Name="PPRO" Version="[13.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.bunnysframelab.audioseparator.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Bunnys Audio Separator</Menu>
          <Geometry>
            <Size>
              <Height>760</Height>
              <Width>380</Width>
            </Size>
            <MinSize>
              <Height>420</Height>
              <Width>290</Width>
            </MinSize>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./assets/icon.png</Icon>
            <Icon Type="RollOver">./assets/icon.png</Icon>
            <Icon Type="DarkNormal">./assets/icon.png</Icon>
            <Icon Type="DarkRollOver">./assets/icon.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
